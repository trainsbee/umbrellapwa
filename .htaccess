# ------------------------------------------------------------------
# UmbrellaApp - Apache configuration for the PWA
# Secrets do NOT belong here: use includes/config.local.php (git-ignored).
# ------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.php

# MIME types the PWA needs
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType text/javascript .js
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType font/woff2 .woff2
    AddCharset utf-8 .js .css .webmanifest .html
</IfModule>

# Block internal folders and sensitive files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|tools|deploy|vendor|database)/ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(sql|md|log|zip)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    # Basic security
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    # PHP pages: always fresh
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, private"
    </FilesMatch>

    # Static assets (carry a ?v= version)
    <FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # The service worker and manifest are never cached by the browser, so
    # updates arrive immediately. (Placed after the assets rule so it wins.)
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/manifest+json image/svg+xml
</IfModule>
